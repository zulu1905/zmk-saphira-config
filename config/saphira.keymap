#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.dtsi>
#include <dt-bindings/zmk/pointing.dtsi>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &mkp LCLK    // Sol Tık
                &mkp RCLK    // Sağ Tık
                &mkp MCLK    // Orta Tık
                &mkp MB4     // Yan Tuş (İleri)
                &mkp MB5     // Yan Tuş (Geri)
            >;

            sensor-bindings = <&inc_dec_kp MOVE_Y(-1) MOVE_Y(1)>;
        };
    };
};
